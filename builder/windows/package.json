{
  "name": "warpvio-windows-builder",
  "version": "0.1.0",
  "private": true,
  "description": "Warpvio Windows QA application shell and NSIS installer builder",
  "main": "app/main.cjs",
  "author": "Warpvio",
  "license": "UNLICENSED",
  "scripts": {
